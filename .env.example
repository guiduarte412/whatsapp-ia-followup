# Porta onde o servico vai rodar
PORT=3000

# --- Claude API (geracao das mensagens humanizadas) ---
# Crie sua chave em https://console.anthropic.com
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
# Haiku 4.5 e o mais barato e da conta tranquilamente para mensagens curtas de WhatsApp
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Gateway de WhatsApp (Z-API, conecta no seu WhatsApp Business via QR Code) ---
# Pegue esses dados no painel da Z-API depois de criar a instancia
ZAPI_INSTANCE_ID=coloque_aqui
ZAPI_TOKEN=coloque_aqui
ZAPI_CLIENT_TOKEN=coloque_aqui

# Seu numero (o consultor), para onde a IA manda o aviso quando um lead responde
# Formato: codigo do pais + DDD + numero, so digitos (ex: 5555999999999)
CONSULTOR_WHATSAPP=5547992412727

# --- RD Station (opcional, so se quiser validar a assinatura do webhook) ---
RDSTATION_WEBHOOK_SECRET=

# --- Janela de horario permitido para disparo (evita parecer robotico/spam) ---
HORARIO_INICIO=8
HORARIO_FIM=20

# --- Horarios de "manha" e "final do dia" pra 2a mensagem em diante ---
# (a 1a mensagem sempre sai 30-60 min depois do lead entrar, sorteado -
# isso nao e configuravel por variavel, e calculado na hora)
HORA_MANHA=9
HORA_FIM_DIA=18

# --- Identidade usada na primeira mensagem (nome e empresa que o consultor usa pra se apresentar) ---
CONSULTOR_NOME=Guilherme
CONSULTOR_EMPRESA=Fourcon | FourAgro

# --- Limite de respostas automaticas seguidas antes de forcar o encaminhamento pro humano ---
MAX_RESPOSTAS_AUTOMATICAS=5
