# Estas variaveis sao so as credenciais tecnicas (chaves de API, porta).
#
# NADA do comportamento do sistema mora aqui: seu nome, sua empresa, o texto
# das mensagens, as regras que a IA segue e os horarios de envio sao todos
# editados na tela de Configuracoes do proprio site, sem mexer em codigo nem
# no Railway.

# Porta onde o servico vai rodar
PORT=3000

# --- Claude API (conversa com o cliente + leitura de imagem/figurinha) ---
# Crie sua chave em https://console.anthropic.com
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
# Haiku 4.5 e o mais barato e da conta tranquilamente para mensagens de WhatsApp
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (opcional - so pra transcrever audio que o cliente manda) ---
# Sem isso, mensagem de voz do cliente so gera um aviso pra voce ouvir manualmente.
# Crie sua chave em https://platform.openai.com
OPENAI_API_KEY=

# --- Gateway de WhatsApp (Z-API, conecta no seu WhatsApp via QR Code) ---
# Pegue esses dados no painel da Z-API depois de criar a instancia
ZAPI_INSTANCE_ID=coloque_aqui
ZAPI_TOKEN=coloque_aqui
ZAPI_CLIENT_TOKEN=coloque_aqui

# Seu numero, para onde o sistema manda os avisos (lead respondeu, horario
# confirmado, envio falhando).
# Formato: codigo do pais + DDD + numero, so digitos (ex: 5547999999999)
CONSULTOR_WHATSAPP=5547992412727
